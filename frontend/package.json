{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/lab": "^9.0.0-beta.9",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "9.14.0",
    "@mui/x-date-pickers": "9.14.0",
    "@sentry/react": "^9.22.0",
    "globals": "^16.2.0",
    "moment": "2.31.0",
    "moment-timezone": "0.6.0",
    "node-fetch": "3.3.2",
    "notistack": "3.0.2",
    "react": "19.3.0",
    "react-big-calendar": "^1.20.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "2.15.3",
    "web-vitals": "5.0.1"
  },
  "scripts": {
    "start": "vite dev --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --watch=false",
    "test:pact": "cross-env CI=true react-scripts test --runInBand --setupFiles ./pact/setup.ts --setupFilesAfterEnv ./pact/jest-wrapper.ts --testMatch \"**/*.test.pact.tsx\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "17.1.4",
    "@pact-foundation/pact-node": "10.18.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "5.0.2",
    "cross-env": "10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "jest": "29.7.0",
    "jest-pact": "0.14.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "prop-types": "^15.8.1",
    "storybook": "^10.6.0",
    "ts-jest": "29.4.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^5.0.1",
    "whatwg-fetch": "3.6.20"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
