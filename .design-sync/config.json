  "storyImports": {
    "shim": [
      "react-router-dom",
      "@mui/material"
    ]
  },
  "readmeHeader": ".design-sync/conventions.md",
  "libOverrides": {
    "preview-gen-storybook.mjs": "Wrap each story like .storybook/preview.tsx: BackgroundFxProvider + MemoryRouter unless parameters.router===false; merge meta+story parameters"
  }
