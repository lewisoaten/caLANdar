{
  "projectId": "11c1dd7d-ac52-479a-881c-df6405fb14ba",
  "shape": "storybook",
  "storybookConfigDir": "frontend/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "pkg": "calandar",
  "globalName": "CaLANdar",
  "buildCmd": "sh frontend/design-sync-pkg/build-types.sh",
  "titleMap": {
    "Button": null,
    "Header": null,
    "Eventlobby": "Event",
    "Theme": null
