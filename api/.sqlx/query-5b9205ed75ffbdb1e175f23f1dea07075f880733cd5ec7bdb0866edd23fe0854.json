{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            r.id,\n            r.event_id,\n            r.name,\n            r.description,\n            r.image,\n            r.sort_order,\n            r.created_at,\n            r.last_modified,\n            r.grid_rows,\n            r.features,\n            r.background_style,\n            r.background_opacity,\n            rb.token AS \"background_token?\"\n        FROM room r\n        LEFT JOIN room_background rb ON rb.room_id = r.id\n        WHERE r.event_id = $1\n        ORDER BY r.sort_order, r.id\n        ",
