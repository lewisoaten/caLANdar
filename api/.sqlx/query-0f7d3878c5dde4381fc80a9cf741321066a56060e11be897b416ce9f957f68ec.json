  "db_name": "PostgreSQL",
  "query": "\n        UPDATE seat\n        SET\n            label = $2,\n            name = $3,\n            description = $4,\n            x = $5,\n            y = $6,\n            grid_col = COALESCE($7, grid_col),\n            grid_row = COALESCE($8, grid_row),\n            last_modified = NOW()\n        WHERE id = $1\n        RETURNING\n            id,\n            event_id,\n            room_id,\n            label,\n            name,\n            description,\n            x,\n            y,\n            created_at,\n            last_modified,\n            grid_col,\n            grid_row\n        ",
