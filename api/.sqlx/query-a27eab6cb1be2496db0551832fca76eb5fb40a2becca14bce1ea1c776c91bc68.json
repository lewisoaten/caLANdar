  "query": "\n        SELECT\n            e.id,\n            e.created_at,\n            e.last_modified,\n            e.title,\n            e.description,\n            e.image,\n            e.time_begin,\n            e.time_end,\n            i.response AS \"my_response: crate::repositories::invitation::Response\"\n        FROM event e\n        INNER JOIN invitation i ON i.event_id = e.id\n        WHERE LOWER(i.email) = LOWER($1)\n        ",
